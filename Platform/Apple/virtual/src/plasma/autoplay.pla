include "gamelib.plh"
include "globalDefs.plh"
include "autoplay.plh"

// Exported functions go here. First a predef for each one, then a table with function pointers
// in the same order as the constants are defined in the the header.
predef _init()#1
word[] funcTbl = @_init

word real_DisplayChar

asm _defs

; Use hi-bit ASCII for Apple II
!convtab "../../include/hiBitAscii.ct"

; Headers
!source "../../include/global.i"
!source "../../include/plasma.i"
!source "../../include/mem.i"
!source "../../include/fontEngine.i"

tmp         = $2   ; length 2
pTmp        = $4   ; length 2

end

asm patched_DisplayChar
!zone
  clc
  bcc fakedc
realdc:
  jmp 0
fakedc:
  +prStr : !text "DisplayChar ",0
  +prA
  +crout
  inc $7D0
  clc
  bcc realdc
end

asm patched_DisplayStr
!zone
  clc
  bcc fakeds
realds:
  jmp 0
fakeds:
  +prStr : !text "DisplayStr ",0

  sty pTmp+1
  sta pTmp

  ldy #0
  lda (pTmp),y
  tax
  beq empty
nextch:
  iny
  lda (pTmp),y
  ora #$80
  +safeCout
  dex
  bne nextch
empty:
  ldy pTmp+1
  lda pTmp
  inc $7D1
  clc
  bcc realds
end

///////////////////////////////////////////////////////////////////////////////////////////////////
asm patchDisplayChar(func)#1
  +asmPlasmRet 1
  tax   ; save param lo
  lda DisplayChar+1
  pha
  lda DisplayChar+2
  pha
  stx DisplayChar+1
  sty DisplayChar+2
  pla
  tay
  pla
  rts
end

///////////////////////////////////////////////////////////////////////////////////////////////////
asm patchDisplayStr(func)#1
  +asmPlasmRet 1
  tax   ; save param lo
  lda DisplayStr+1
  pha
  lda DisplayStr+2
  pha
  stx DisplayStr+1
  sty DisplayStr+2
  pla
  tay
  pla
  rts
end

///////////////////////////////////////////////////////////////////////////////////////////////////
def _init()#1
  word patched, prev
  puts("autoplay init\n")

  patched = @patched_DisplayChar
  prev = patchDisplayChar(patched)
  *(patched+4) = prev

  patched = @patched_DisplayStr
  prev = patchDisplayStr(patched)
  *(patched+4) = prev

  return 0
end

///////////////////////////////////////////////////////////////////////////////////////////////////
// Boilerplate module initialization code
return @funcTbl
done
