include "gamelib.plh"
include "globalDefs.plh"
include "autoplay.plh"

// Exported functions go here. First a predef for each one, then a table with function pointers
// in the same order as the constants are defined in the the header.
predef _init()#1
word[] funcTbl = @_init

asm _defs
!convtab "../../include/hiBitAscii.ct"
!source "../../include/global.i"
!source "../../include/plasma.i"
!source "../../include/mem.i"
!source "../../include/fontEngine.i"

tmp         = $2   ; length 2
pTmp        = $4   ; length 2
end

asm my_rawDisplayStr(pStr)#0
!zone
  +prStr : !text "rawDisplayStr: ",0
  lda evalStkL,x
  sta pTmp
  lda evalStkH,x
  sta pTmp+1
  tya
  pha
  txa
  pha
  ldy #0
  lda (pTmp),y
  tax
  beq donech
prchr:
  iny
  lda (pTmp),y
  ora #$80
  cmp #$A0
  bcs notctrl
  +prChr '^'
  adc #$40
notctrl:
  +safeCout
  dex
  bne prchr
donech:
  +crout
  pla
  tax
  pla
  tay
  jmp _asmPlasm
end

asm my_displayChar(ch)#0
!zone
  +prStr : !text "displayChar: ",0
  lda evalStkL,x
  ora #$80
  cmp #$A0
  bcs notctrl2
  +prChr '^'
  adc #$40
notctrl2:
  +safeCout
  +crout
  jmp _asmPlasm
end

asm my_clearWindow()#0
!zone
  +prStr : !text "clearWindow",$8D,0
  jmp _asmPlasm
end

asm my_setWindow()#0
!zone
  +prStr : !text "setWindow: ",0
  tya
  pha
  
  lda evalStkH+3,x
  tay
  lda evalStkL+3,x
  +prYA

  lda evalStkH+2,x
  tay
  lda evalStkL+2,x
  +prYA
  
  lda evalStkH+1,x
  tay
  lda evalStkL+1,x
  +prYA
  
  lda evalStkH,x
  tay
  lda evalStkL,x
  +prYA
  
  +crout
  
  pla
  tay
  jmp _asmPlasm
end

///////////////////////////////////////////////////////////////////////////////////////////////////
def patch_asm(pOrig, pMy)#0
  *(pOrig+3) = pMy
end

///////////////////////////////////////////////////////////////////////////////////////////////////
def _init()#1
  patch_asm(@rawDisplayStr, @my_rawDisplayStr)
  patch_asm(@displayChar, @my_displayChar)
  patch_asm(@clearWindow, @my_clearWindow)
  patch_asm(@setWindow, @my_setWindow)
  return 0
end

///////////////////////////////////////////////////////////////////////////////////////////////////
// Boilerplate module initialization code
return @funcTbl
done
